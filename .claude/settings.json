{
  "permissions": {
    "deny": [
      "Read(./public/models/**)",
      "Read(./dist/**)",
      "Read(./node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-large-reads.mjs\"" }]
      }
    ]
  }
}
